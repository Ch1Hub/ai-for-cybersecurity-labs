*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.docx  binary
*.pptx  binary
*.odt   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.cap   binary
*.pcap  binary
*.img   binary
*.dd    binary
*.bin   binary
